{
  "schema_version": "1",
  "input": "demo-raw.h5",
  "output": "demo-processed.h5",
  "backend": "native",
  "threads": 1,
  "memory_bytes": 268435456,
  "operations": [
    {"op": "window", "axis": "t2", "kind": "exponential", "lb_hz": 1.0},
    {"op": "zero_fill", "axis": "t2", "size": 512},
    {"op": "fft", "axis": "t2"},
    {"op": "phase", "axis": "t2", "p0": 0.0, "p1": 0.0},
    {"op": "window", "axis": "t1", "kind": "exponential", "lb_hz": 1.0},
    {"op": "zero_fill", "axis": "t1", "size": 128},
    {"op": "fft", "axis": "t1"},
    {"op": "phase", "axis": "t1", "p0": 0.0, "p1": 0.0}
  ]
}
